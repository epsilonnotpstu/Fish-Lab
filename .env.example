# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@localhost:5432/labsite?schema=public"

# Random secret, at least 32 characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=""

# Public URL of the site (used for SEO, sitemap, and to enable HTTPS-only CSP)
SITE_URL="https://your-lab.up.railway.app"

# First super admin, created by `npm run db:seed` (must change password on first login)
SEED_ADMIN_EMAIL="admin@your-lab.edu"
SEED_ADMIN_PASSWORD="Use-A-Strong-Temporary-Pass1"
SEED_ADMIN_NAME="Site Administrator"

# ── Email option A (recommended on Railway, which blocks SMTP): Gmail relay over HTTPS.
# Deploy scripts/gmail-relay.gs as a Google Apps Script web app; paste its URL here.
MAIL_WEBHOOK_URL=""
MAIL_WEBHOOK_SECRET=""

# ── Email option B: SMTP (e.g. Gmail — free, sends to anyone, ~500/day). Takes priority over Resend.
# Gmail: enable 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# For Gmail, MAIL_FROM must use the same address as SMTP_USER, e.g. "Lab Name <you@gmail.com>"

# ── Email option C: Resend — member sign-up/sign-in codes, admin 2-step login, contact notifications
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend (onboarding@resend.dev only delivers to your own Resend account email)
MAIL_FROM="Lab Website <no-reply@your-lab.edu>"
# Where contact-form notifications go (defaults to the lab email in Site Settings)
MAIL_TO=""

# Require an emailed 6-digit code after the password for admins/editors ("true" to enable)
ADMIN_2FA="false"

# ── Image & file uploads (Cloudinary) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="lab-website"

# ── "Continue with Google" for members (Google Cloud Console → OAuth client, type Web application)
# Authorised redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
